# ── Edgewise trading bot — environment ─────────────────────────────────
# Fill in the values, keep this file PRIVATE (it is git-ignored). Never paste
# these into chat. Copy structure from .env.example if you ever need to reset.

# ── Telegram alerts (required for Phase 2) ─────────────────────────────
# 1) In Telegram, message @BotFather → /newbot → copy the token below.
# 2) Message your new bot once, then we'll fetch your chat id (or use @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live market data ───────────────────────────────────────────────────
# Crypto (ETHUSD) uses Binance public API — NO key needed.
# SPX500 + EURUSD live quotes via Twelve Data free tier (twelvedata.com → API key).
TWELVEDATA_API_KEY=

# ── Run mode ───────────────────────────────────────────────────────────
# paper =
RUN_MODE=
RISK_PCT=
MAX_CONCURRENT=

# ── Broker (Phase 4 — execution, leave blank for now) ──────────────────
# IC Markets via MetaTrader 5 (needs a Windows host/VPS — MT5 Python is Windows-only)
ICMARKETS_MT5_LOGIN=
ICMARKETS_MT5_PASSWORD=
ICMARKETS_MT5_SERVER=
